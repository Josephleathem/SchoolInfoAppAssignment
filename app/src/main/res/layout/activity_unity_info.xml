<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/unityInfoScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".unityInfo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/unityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/unityTitle"
            android:textColor="#467F35"
            android:textSize="40sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/unityLogo"
            android:layout_width="188dp"
            android:layout_height="131dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/unityLogoDescription"
            app:srcCompat="@drawable/unity_logo" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tvInfo"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/unityPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/unityPhone"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/unityAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/unityAddress"
            android:textSize="30sp" />

        <Button
            android:id="@+id/btMapView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#467F35"
            android:text="@string/btMapView"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btDirections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#5A9E43"
            android:text="@string/btDirections"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tvHighlights"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/unityHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/unityHighlights"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btReturn"
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2D5AAA"
            android:text="@string/btReturn"
            android:textSize="24sp" />

    </LinearLayout>

</ScrollView>