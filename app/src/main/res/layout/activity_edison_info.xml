<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edisonInfoScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".EdisonInfo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/edisonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/edisonTitle"
            android:textColor="#007A79"
            android:textSize="40sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/edisonLogo"
            android:layout_width="182dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/edisonLogoDescription"
            app:srcCompat="@drawable/edison_logo" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tvInfo"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/CiatPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edisonPhone"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/CiatAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edisonAddress"
            android:textSize="30sp" />

        <Button
            android:id="@+id/btMapView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#007A79"
            android:text="@string/btMapView"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btDirections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F7CF0B"
            android:text="@string/btDirections"
            android:textColor="#000000"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tvHighlights"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/edisonHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edisonHighlights"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btReturn"
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2D5AAA"
            android:text="@string/btReturn"
            android:textSize="24sp" />

    </LinearLayout>

</ScrollView>