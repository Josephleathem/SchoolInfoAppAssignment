<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ciatInfoScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".Info">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/ciatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ciatTitle"
            android:textColor="#0868CE"
            android:textSize="40sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/CiatLogo"
            android:layout_width="189dp"
            android:layout_height="146dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/ciatLogoDescription"
            app:srcCompat="@drawable/ciat_icon" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tvInfo"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/CiatPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ciatPhone"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/CiatAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ciatAddress"
            android:textSize="30sp" />

        <Button
            android:id="@+id/btMapView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0868CE"
            android:text="@string/btMapView"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btDirections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#096AD2"
            android:text="@string/btDirections"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tvHighlights"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/ciatHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ciatHighlights"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btReturn"
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2D5AAA"
            android:text="@string/btReturn"
            android:textSize="24sp" />

    </LinearLayout>

</ScrollView>